# Copy this file to .env and configure the local machine before starting.
# Literal KEY=value syntax; no variable expansion, escapes, or inline comments.
# Values may be enclosed in single or double quotes. Use absolute JDK paths.
JAVA_HOME=
# Optional: directory containing node.exe and pnpm.cmd. Empty uses PATH.
SQUIRE_NODE_HOME=
SQUIRE_PORT=8787
SQUIRE_WEB_PORT=5173
# Backend bind address. Keep 127.0.0.1 for local mode; use 0.0.0.0 only for a trusted LAN service.
SQUIRE_BIND_ADDRESS=127.0.0.1
# Optional advertised URL used by the Connection page. Do not use 0.0.0.0 here.
SQUIRE_PUBLIC_BASE_URL=
# Frontend dev server bind address. Keep 127.0.0.1 unless LAN browser access is explicitly enabled.
SQUIRE_WEB_BIND_ADDRESS=127.0.0.1
# Optional comma-separated browser origins; * explicitly allows all origins for trusted LAN testing.
SQUIRE_ALLOWED_ORIGINS=
# Relative data paths resolve from the project root, not the current directory.
SQUIRE_DATA_DIR=.runtime/data
SQUIRE_UPSTREAM_IDLE_SECONDS=120
SQUIRE_UPSTREAM_TOTAL_SECONDS=1800
