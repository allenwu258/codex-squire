{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Squire",
  "version": "0.2.2",
  "identifier": "dev.squire.codex-squire",
  "build": {
    "beforeDevCommand": "pnpm --dir ../frontend dev --host 127.0.0.1 --port 5173",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../frontend build",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Codex Squire",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:* http://tauri.localhost; connect-src 'self' http://127.0.0.1:* http://localhost:* http://tauri.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/icon.icns"],
    "targets": "all",
    "resources": {
      "../backend/build/libs/codex-squire-0.2.2.jar": "backend.jar",
      "../frontend/dist": "frontend"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
